{
  "manifest_version": 3,
  "name":"Clipper",
  "version": "0.1",
  "description": "Seamless stream and media clipping.",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Clipper"
  },
"permissions": [
    "storage",
    "cookies",
    "downloads",
    "webRequest"
  ],
"host_permissions": [
    "*://*.youtube.com/*",
    "*://*.googlevideo.com/*",
    "*://*.tiktok.com/*",
    "*://*.instagram.com/*",
    "*://*.twitch.tv/*",
    "*://*.ttvnw.net/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
    "icons": {
  "128": "Scissors.png"
},
  "content_scripts": [
    {
      "matches": [
        "*://*.youtube.com/*",
        "*://*.tiktok.com/*",
        "*://*.instagram.com/*",
        "*://*.twitch.tv/*"
      ],
      "js": ["content.js"]
    }
  ],
  "commands": {
    "_execute_action": {
      "suggested_key": {
        "default": "Ctrl+Q",
        "mac": "Command+Q"
      },
      "description": "Open Quick Download Menu"
    }
  }
}